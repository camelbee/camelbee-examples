<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camelbee</groupId>
    <artifactId>camelbee-quarkus-starter</artifactId>
    <version>3.1.0</version>
  </parent>

  <artifactId>product-catalog-mcp</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>product-catalog-mcp</name>
  <description>CamelBee productcatalogservice API</description>

  <properties>
    <!-- ... -->
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ... -->
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-mapstruct</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-resteasy-jackson</artifactId>
    </dependency>


    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-agroal</artifactId>
    </dependency>


    <!-- jdbc component is needed to run the sql statements to reset test data-->
    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
    </dependency>


    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>


    <dependency>
      <groupId>io.quarkiverse.mcp</groupId>
      <artifactId>quarkus-mcp-server-http</artifactId>
      <version>1.9.1</version>
    </dependency>

    <dependency>
      <groupId>io.quarkiverse.mcp</groupId>
      <artifactId>quarkus-mcp-server-test</artifactId>
      <scope>test</scope>
      <version>1.9.1</version>
    </dependency>

    <!-- MCP client SDK for black-box tests (connects to Docker container) -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>0.17.1</version>
      <scope>test</scope>
    </dependency>

    <!-- Required by mcp SDK: json-schema-validator is not pulled in transitively -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>2.0.0</version>
      <scope>test</scope>
    </dependency>


    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-http</artifactId>
    </dependency>


    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
    </dependency>


    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>


    <!-- Required for native compilation of jms component -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-reflect</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Required for native compilation of jwt-->
    <dependency>
      <groupId>com.google.crypto.tink</groupId>
      <artifactId>tink</artifactId>
    </dependency>
    <!-- Required for generating gRPC service classes that reference javax annotations -->


  </dependencies>

  <!-- BUILD: Define specific build plugins here -->
  <build>


    <plugins>
      <!-- OpenApi Generator -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator-maven-plugin.version}</version>
        <executions>

          <!-- Microservice exposes MCP api, we need to create camel restconfiguration via rest-openapi and model classes using the order-api.yaml  -->
          <execution>
            <id>generate-mcp-sources-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <inputSpec>${project.basedir}/src/main/resources/mcp/order-mcp-api.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <generateApis>false</generateApis>
              <modelPackage>com.mycompany.catalog.mcp.model.api.mcp</modelPackage>
              <configOptions>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useBeanValidation>true</useBeanValidation>
                <sourceFolder>src/main/java</sourceFolder>
                <interfaceOnly>true</interfaceOnly>
                <singleContentTypes>true</singleContentTypes>
                <useTags>true</useTags>
                <oas3>true</oas3>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <useJakartaEe>true</useJakartaEe>
                <dateLibrary>java8</dateLibrary>
              </configOptions>
            </configuration>
          </execution>

          <!-- Microservice calls a backend REST api, we need to create model classes using the purchase-api.yaml  -->
          <execution>
            <id>generate-rest-sources-infra</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <inputSpec>${project.basedir}/src/main/resources/backends/openapi/purchase-api.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <generateApis>false</generateApis>
              <modelPackage>com.mycompany.catalog.mcp.model.infra.json</modelPackage>
              <configOptions>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useBeanValidation>true</useBeanValidation>
                <sourceFolder>src/main/java</sourceFolder>
                <interfaceOnly>true</interfaceOnly>
                <singleContentTypes>true</singleContentTypes>
                <useTags>true</useTags>
                <oas3>true</oas3>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <useJakartaEe>true</useJakartaEe>
                <dateLibrary>java8</dateLibrary>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>


    </plugins>
  </build>

  <!-- PROFILES: Define specific profiles here -->
  <profiles>
    <!-- ... -->
  </profiles>

  <!-- REPORTING: Define specific reporting plugins here -->
  <reporting>
    <!-- ... -->
  </reporting>

</project>
