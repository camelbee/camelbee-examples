# This tells Lombok this directory is the root, no need to look somewhere else for Java code.
config.stopBubbling = true
# This will add the @lombok.Generated annotation to all the code generated by Lombok,
# so it can be excluded from coverage by JaCoCo.
lombok.addLombokGeneratedAnnotation=true
# Generated setters will 'chain' by default (They will return this instead of having a void return type).
lombok.accessors.chain=true
lombok.copyableannotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableannotations += org.springframework.beans.factory.annotation.Value