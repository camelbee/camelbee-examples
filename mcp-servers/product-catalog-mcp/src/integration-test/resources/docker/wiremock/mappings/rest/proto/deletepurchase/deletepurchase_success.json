{
  "priority": 5,
  "request": {
    "method": "DELETE",
    "urlPathPattern": "/purchase-service-api/purchases/[0-9]+",
    "headers": {
      "Accept": {
        "equalTo": "application/x-protobuf"
      }
    },
    "queryParameters": {
      "salesChannel": {
      "equalTo": "ONLINE"
      }
    }
  },
  "response": {
    "status": 204,
    "transformers": [],
    "transformerParameters": {
     "disableBodyFileTemplating": true
    }
  }
}