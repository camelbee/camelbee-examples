{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/purchase-service-api/purchases/[0-9]+",
    "headers": {
      "Accept": {
        "equalTo": "application/json"
      }
    },
    "queryParameters": {
    "salesChannel": {
      "equalTo": "ONLINE"
    }
  }
  },
  "response": {
    "status": 201,
    "transformers": [],
    "transformerParameters": {
     "disableBodyFileTemplating": true
    },
    "bodyFileName": "rest/json/getpurchase/getpurchase-success-response.json"
  }
}