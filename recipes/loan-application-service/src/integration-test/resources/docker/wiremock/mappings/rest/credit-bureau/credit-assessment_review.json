{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/credit-assessments",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.creditScore",
          "matches": "^(5[0-9][0-9]|6[0-4][0-9])$"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"],
    "jsonBody": {
      "assessmentId": "ASSESS-{{randomValue length=10 type='UPPER_HEX'}}",
      "approved": false,
      "riskScore": 72,
      "reason": "Credit score below threshold — manual review required",
      "recommendedMaxAmount": 10000.00
    }
  }
}
