{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/credit-assessments",
    "headers": {
      "X-Force-Bureau-Failure": {
        "equalTo": "true"
      }
    }
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "BUREAU-UNAVAILABLE",
      "message": "Credit bureau temporarily unavailable"
    }
  }
}
