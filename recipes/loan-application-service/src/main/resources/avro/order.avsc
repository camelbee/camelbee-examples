[
  {
    "type": "record",
    "name": "LoanApplicationSubmittedEvent",
    "namespace": "io.fintech.loan.application.service.model.api.avro",
    "doc": "Event published when a loan application is submitted",
    "fields": [
      { "name": "applicationId",    "type": "string" },
      { "name": "applicantId",      "type": "string" },
      { "name": "applicantName",    "type": "string" },
      { "name": "applicantEmail",   "type": "string" },
      { "name": "requestedAmount",  "type": "double" },
      { "name": "purpose",          "type": "string" },
      { "name": "termMonths",       "type": "int" },
      { "name": "monthlyIncome",    "type": "double" },
      { "name": "creditScore",      "type": "int" },
      { "name": "employmentStatus", "type": "string" },
      { "name": "submittedAt",      "type": { "type": "long", "logicalType": "timestamp-millis" } }
    ]
  },
  {
    "type": "record",
    "name": "LoanApplicationProcessedEvent",
    "namespace": "io.fintech.loan.application.service.model.api.avro",
    "doc": "Event published when a loan application has been processed (auto-approved, auto-rejected, or bureau-assessed)",
    "fields": [
      { "name": "applicationId", "type": "string" },
      { "name": "applicantId",   "type": "string" },
      { "name": "decision",      "type": "string" },
      { "name": "riskScore",     "type": ["null", "int"], "default": null },
      { "name": "reason",        "type": ["null", "string"], "default": null },
      { "name": "processedAt",   "type": { "type": "long", "logicalType": "timestamp-millis" } }
    ]
  },
  {
    "type": "record",
    "name": "Error",
    "namespace": "io.fintech.loan.application.service.model.api.avro",
    "doc": "Representation of an error",
    "fields": [
      { "name": "code",    "type": "string" },
      { "name": "message", "type": "string" }
    ]
  }
]
